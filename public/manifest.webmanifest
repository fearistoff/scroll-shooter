{
  "name": "Zombie Crowd Shooter",
  "short_name": "Crowd Shooter",
  "description": "Прототип мобильной crowd-shooter игры: отряд стрелков едет по дороге, отбивается от зомби и растёт на бонусах.",
  "lang": "ru",
  "id": "zombie-crowd-shooter",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "portrait",
  "background_color": "#0b0b0e",
  "theme_color": "#0b0b0e",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
